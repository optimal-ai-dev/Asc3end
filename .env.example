# Copy this file to .env.local and fill in real values. Never commit .env.local to git.

# From your Supabase project settings (Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# From https://console.anthropic.com — set this in Vercel's project environment variables
# for production, NOT in this file if you ever commit it. This one is server-only, never
# exposed to the browser (that's why it's not prefixed with VITE_).
ANTHROPIC_API_KEY=

# Stripe test/sandbox keys (dashboard.stripe.com/test/apikeys). Secret key and price ids are
# server-only — never prefix with VITE_. Run `node scripts/setup-stripe-pricing.mjs` once
# STRIPE_SECRET_KEY is set to create the Asc3end+ product with both prices and print
# STRIPE_MONTHLY_PRICE_ID/STRIPE_ANNUAL_PRICE_ID to fill in below.
STRIPE_SECRET_KEY=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
# From Stripe Dashboard → Developers → Webhooks, after creating the endpoint (see README).
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Supabase service_role secret (Settings > API > API Keys > secret) — bypasses Row Level
# Security. Server-only, used only by the Stripe webhook and other /api routes to act outside
# any single user's session. NEVER prefix with VITE_ or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical production app URL — used server-side to build absolute redirect URLs (Stripe
# Checkout success/cancel) instead of trusting request headers. e.g. https://asc3end.vercel.app
APP_URL=

# Support/contact address shown in-app (Support area, legal pages, error screens) and used by
# the launch-configuration check (see scripts/check-launch-config.mjs).
SUPPORT_EMAIL=

# Business details for legal pages (Terms, Privacy, refund policy). Leave blank in development;
# the launch-configuration check treats these as required before a production launch — see
# LAUNCH_READINESS.md's "requires owner action" section for why placeholder legal text must
# never go live.
LEGAL_BUSINESS_NAME=
LEGAL_BUSINESS_ABN=
LEGAL_BUSINESS_ADDRESS=

# Optional — error monitoring (Phase 11). Leave blank to run without it; the app degrades to a
# local-only error boundary with no remote reporting.
SENTRY_DSN=

# Optional — product analytics beyond the built-in Supabase-based analytics_events (Phase 10).
# Leave blank to use only the built-in analytics.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
