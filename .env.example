# Copy this file to .env.local and fill in real values. Never commit .env.local to git.

# From your Supabase project settings (Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# From https://console.anthropic.com — set this in Vercel's project environment variables
# for production, NOT in this file if you ever commit it. This one is server-only, never
# exposed to the browser (that's why it's not prefixed with VITE_).
ANTHROPIC_API_KEY=

# Stripe test/sandbox keys (dashboard.stripe.com/test/apikeys). Secret key and price ID are
# server-only — never prefix with VITE_. Run `node scripts/setup-stripe.mjs` once STRIPE_SECRET_KEY
# is set to create the Premium product/price and fill in STRIPE_PRICE_ID automatically.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# From Stripe Dashboard → Developers → Webhooks, after creating the endpoint (see README).
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Supabase service_role secret (Settings > API > API Keys > secret) — bypasses Row Level
# Security. Server-only, used only by the Stripe webhook to write subscription status outside
# any user session. NEVER prefix with VITE_ or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
